# Set production values in AWS SSM. Use local values here for development only.

VITE_APP_URL=http://localhost:8080
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
VITE_DEFAULT_BUSINESS_ID=cf941cc4-e1d1-4d7c-8122-a5df81a1e53c

# AWS API server
PORT=3000
DATABASE_URL=
# Local PostgreSQL commonly runs without TLS. Do not disable verification in production.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=8
DB_CONNECTION_TIMEOUT_MS=5000
DEFAULT_BUSINESS_ID=cf941cc4-e1d1-4d7c-8122-a5df81a1e53c
ADMIN_API_KEY=
ADMIN_SESSION_HOURS=8
USER_SESSION_DAYS=30
UPLOAD_DIR=./uploads
PRIVATE_UPLOAD_DIR=./private-uploads
MAX_UPLOAD_BYTES=5242880
MAX_SOCIAL_UPLOAD_BYTES=26214400
MAX_DOCUMENT_UPLOAD_BYTES=10485760
MAX_AI_ATTACHMENT_BYTES=15728640
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Pet character studio uses GEMINI_API_KEY by default. To use Vertex instead,
# set either VERTEX_AI_API_KEY (express mode) or GOOGLE_CLOUD_PROJECT with ADC.
PET_CHARACTER_IMAGE_MODEL=gemini-2.5-flash-image
PET_CHARACTER_VISION_MODEL=gemini-2.5-flash
VERTEX_AI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Legacy model-name aliases; PET_CHARACTER_* takes precedence.
VERTEX_AI_IMAGE_MODEL=gemini-2.5-flash-image
VERTEX_AI_VISION_MODEL=gemini-2.5-flash
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=MIPO <onboarding@resend.dev>
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_DEBUG=false
PUBLIC_APP_URL=http://localhost:8080
# Leave all four CardCom values empty to disable payments. If any is set, all four are required.
CARDCOM_TERMINAL_NUMBER=
CARDCOM_USERNAME=
CARDCOM_API_PASSWORD=
CARDCOM_WEBHOOK_SECRET=

# ─── Outbound events (automation layer) ────────────────────────────────
# Leave AUTOMATION_WEBHOOK_URL empty to record events without delivering them.
# Events accumulate in the outbox either way, so enabling delivery later
# replays everything recorded while it was off.
AUTOMATION_WEBHOOK_URL=
# Signs each delivery as X-Mipo-Signature (HMAC-SHA256 over the raw body).
AUTOMATION_WEBHOOK_SECRET=
AUTOMATION_DISPATCH_INTERVAL_MS=5000
AUTOMATION_DISPATCH_BATCH=20
AUTOMATION_DISPATCH_TIMEOUT_MS=10000
# Deliver events that an automation platform itself caused. Off by default —
# this is what stops a workflow from re-triggering itself.
AUTOMATION_DELIVER_OWN_EVENTS=false

# Owner WhatsApp (Twilio). Leave OWNER_NOTIFICATIONS_ENABLED unset or false
# and nothing is sent. All five values are required before a message goes out.
# FROM and TO are whatsapp:+ and a country code, with no spaces.
# Production stores these in AWS SSM under /mipo/prod/ and syncs them into
# /opt/mipo/.env. GitHub Actions (deploy result and the site-health workflow)
# reads the same names as repository secrets. Neither place is filled in here.
OWNER_NOTIFICATIONS_ENABLED=
# Public origin for links inside those messages. Same origin as PUBLIC_APP_URL.
# The notifier reads only SITE_URL and does not fall back. Not a secret.
# Set the same value as a GitHub Actions variable so deploy and site-health
# messages can link too. The workflows pass vars.SITE_URL, or
# vars.MIPO_PUBLIC_BASE_URL when SITE_URL is unset, into the process as SITE_URL.
SITE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
OWNER_WHATSAPP_TO=
# Optional. JSON map of event type to a Twilio Content SID, used once a
# template is approved. Empty means a free-form body, which the Sandbox
# accepts inside the session window.
# Keys: order.paid, payment.failed, payment.unsettled, user.registered,
# server.error, site.down, deploy, qa
TWILIO_WHATSAPP_CONTENT_SIDS=
# Shared secret for POST /api/internal/owner-notify/qa. Server only.
OWNER_NOTIFY_QA_SECRET=
OWNER_NOTIFY_THROTTLE_MS=600000
OWNER_NOTIFY_TIMEOUT_MS=4000
