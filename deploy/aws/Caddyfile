# Site addresses come from the environment so one file serves both
# environments. docker-compose passes them through from the host .env:
#
#   production   MIPO_SITE_ADDRESS=mipo.pet
#                MIPO_WWW_ADDRESS=www.mipo.pet
#   staging      MIPO_SITE_ADDRESS=staging.mipo.pet
#                MIPO_WWW_ADDRESS unset
#
# With MIPO_WWW_ADDRESS unset the redirect block binds a plain-HTTP localhost
# port that is never published, so Caddy does not try to obtain a certificate
# for a hostname that does not resolve.

{$MIPO_WWW_ADDRESS:http://localhost:8081} {
	redir https://{$MIPO_SITE_ADDRESS:mipo.pet}{uri} permanent
}

{$MIPO_SITE_ADDRESS:mipo.pet} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		+Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
	}

	# Staging sets MIPO_ROBOTS_POLICY="noindex, nofollow" so it can never be
	# indexed. Production leaves it unset and gets "all", the explicit
	# index-normally value — never an empty header.
	header X-Robots-Tag "{$MIPO_ROBOTS_POLICY:all}"

	# X-Forwarded-For is replaced, not appended to. Caddy's default is to append
	# the peer to whatever the client sent, and the API reads the header to
	# decide which rate-limit bucket a request falls into — so a client that
	# sends its own value gets a fresh bucket on every request and the per-IP
	# limit on the login endpoint stops existing. The same value is recorded on
	# session rows, so it also has to be one nobody chose for themselves.
	handle /api/* {
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /uploads/* {
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Hashed build assets are served before the single-page fallback below, and
	# without it. Under try_files a chunk that no longer exists — every deploy
	# replaces them all, and a browser with the app already open still asks for
	# the old names — would be answered with index.html and a 200, so the
	# browser would refuse an HTML file where it expected a module and the
	# screen would go blank with nothing in the server logs. A 404 is the truth,
	# and it is something the app can react to.
	# Every name under /assets/ carries a content hash, so a given URL's bytes
	# never change. Cache it for a year and immutably: the browser does not even
	# revalidate, and a deploy publishes new names rather than new contents.
	handle /assets/* {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else, and this is the part that matters.
	#
	# Nothing here set Cache-Control at all, which does not mean "do not cache" —
	# it means the browser invents a lifetime, and browsers heuristically cache a
	# 200 that carries no freshness information. index.html and sw.js are exactly
	# the two files that must never be held: index.html names the hashed bundles,
	# and sw.js is what fetches new versions of everything else. Hold those two
	# and a visitor keeps running an old build indefinitely, with no way to tell
	# and nothing a later deploy can do about it.
	#
	# That is not hypothetical. On 9 September one browser was serving a build
	# old enough to still contain a home screen that had been replaced weeks
	# earlier, while a different browser on the same phone showed the current
	# one. The shop looked broken in the stale browser for the same reason: an
	# old bundle calling an API that had moved on.
	#
	# no-cache is not no-store. The file is still stored; it is revalidated, and
	# an unchanged one comes back as a 304 with no body.
	handle {
		root * /srv/www
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
