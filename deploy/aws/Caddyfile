www.mipo.pet {
  redir https://mipo.pet{uri} permanent
}

mipo.pet {
  encode zstd gzip

  handle /api/* {
    reverse_proxy mipo-api:3000
  }

  handle_path /uploads/* {
    root * /srv/uploads
    file_server
  }

  handle {
    root * /srv/www
    try_files {path} /index.html
    file_server
  }
}
