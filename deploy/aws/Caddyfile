# Site addresses come from the environment so one file serves both
# environments. The caddy entrypoint (deploy/aws/caddy-entrypoint.sh) fills
# them in before this file is read:
#
#   production   MIPO_SITE_ADDRESS=mipo.pet
#                MIPO_WWW_ADDRESS=www.mipo.pet   (this is the default)
#   staging      MIPO_SITE_ADDRESS=staging.mipo.pet
#                MIPO_WWW_ADDRESS=http://localhost:8081
#
# www.mipo.pet gets its own certificate and permanently redirects to the apex,
# path and query included. The entrypoint prepends that site. It is not in
# this file: a www block that Caddy cannot load is left out, so the apex
# still starts. Staging never asks for the public www certificate.

{$MIPO_SITE_ADDRESS:mipo.pet} {
	# gzip and zstd. Brotli is not in the stock caddy image, so it is not enabled.
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		+Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
	}

	# Staging sets MIPO_ROBOTS_POLICY="noindex, nofollow" so it can never be
	# indexed. Production leaves it unset and gets "all", the explicit
	# index-normally value — never an empty header. The compose default and
	# the entrypoint both turn an empty value into "all".
	header X-Robots-Tag "{$MIPO_ROBOTS_POLICY:all}"

	# X-Forwarded-For is replaced, not appended to. Caddy's default is to append
	# the peer to whatever the client sent, and the API reads the header to
	# decide which rate-limit bucket a request falls into — so a client that
	# sends its own value gets a fresh bucket on every request and the per-IP
	# limit on the login endpoint stops existing. The same value is recorded on
	# session rows, so it also has to be one nobody chose for themselves.
	handle /api/* {
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /uploads/* {
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# The catalogue sitemap is built by the API (in-stock products, real
	# lastmod). If the API is down, slow, or returns a 5xx, the static page
	# list under /srv/www is the fallback. A 4xx from the API is kept.
	# try_files would answer a missing file with index.html, so this handle
	# does not use it. Dial failures never produce a response, so the
	# site-level handle_errors below serves the same file.
	handle /sitemap.xml {
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
			@upstream_down status 500 502 503 504
			handle_response @upstream_down {
				rewrite * /sitemap.xml
				file_server {
					root /srv/www
					status 200
				}
			}
		}
	}

	# Hashed build assets are served before the single-page fallback below, and
	# without it. Under try_files a chunk that no longer exists — every deploy
	# replaces them all, and a browser with the app already open still asks for
	# the old names — would be answered with index.html and a 200, so the
	# browser would refuse an HTML file where it expected a module and the
	# screen would go blank with nothing in the server logs. A 404 is the truth,
	# and it is something the app can react to.
	# Every name under /assets/ carries a content hash, so a given URL's bytes
	# never change. Cache it for a year and immutably: the browser does not even
	# revalidate, and a deploy publishes new names rather than new contents.
	handle /assets/* {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The worker and the shell are how a deploy reaches a tab that is already
	# open. Caching either of them is how that tab keeps asking for last week's
	# hashed bundle. no-cache makes the browser revalidate on every load.
	@shell path /sw.js /index.html
	handle @shell {
		root * /srv/www
		header Cache-Control "no-cache"
		file_server
	}

	# Fonts and icons are not content-hashed. They still change rarely, and the
	# names are stable, so they are cached for a year. A replacement has to use
	# a new filename. robots.txt, the worker and index.html stay revalidated.
	@branded path /fonts/* /favicon.ico /favicon-16x16.png /favicon-32x32.png /apple-touch-icon.png /pwa-192x192.png /pwa-512x512.png /pwa-maskable-512.png /og-default.png /mipo-mark.svg /placeholder.svg
	handle @branded {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Real files (robots.txt, the worker, the manifest) are served as files.
	# Everything else is a navigation. The API returns index.html with this
	# path's meta tags, and 404 when the path is not a page — try_files would
	# have forced a 200 for every URL.
	handle {
		root * /srv/www
		@static file
		handle @static {
			header Cache-Control "no-cache"
			file_server
		}
		# HTML navigations come from the API so the status and the meta tags
		# match the path. A short timeout, then the shell from disk, so a
		# down API does not take the whole site down. /api is not in this
		# handle: a JSON client must not receive index.html. A 4xx from the
		# API (unknown path, hidden product) is returned as the API sent it.
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
			@upstream_down status 500 502 503 504
			handle_response @upstream_down {
				rewrite * /index.html
				file_server {
					root /srv/www
					status 200
				}
			}
		}
	}

	# Connection failures and timeouts are errors, not responses, so
	# handle_response above does not run. Serve the shell ourselves. Asset,
	# API, and upload errors stay errors: a missing chunk must not become
	# index.html.
	handle_errors {
		@sitemap path /sitemap.xml
		handle @sitemap {
			rewrite * /sitemap.xml
			file_server {
				root /srv/www
				status 200
			}
		}
		@spa {
			not path /api/* /uploads/* /assets/* /fonts/*
			not path *.js *.css *.map *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico *.woff *.woff2 *.ttf *.txt *.xml *.webmanifest *.json
		}
		handle @spa {
			rewrite * /index.html
			file_server {
				root /srv/www
				status 200
			}
		}
	}
}
