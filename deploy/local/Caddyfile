# Deliberately the same routing as production's Caddyfile, minus TLS and the
# real hostnames. An asset that no longer exists must 404 rather than be
# answered with index.html, and a navigation is answered by the API so the
# status and the meta tags match the path.

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /uploads/* {
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /sitemap.xml {
		reverse_proxy mipo-api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /assets/* {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@shell path /sw.js /index.html
	handle @shell {
		root * /srv/www
		header Cache-Control "no-cache"
		file_server
	}

	@branded path /fonts/* /favicon.ico /favicon-16x16.png /favicon-32x32.png /apple-touch-icon.png /pwa-192x192.png /pwa-512x512.png /pwa-maskable-512.png /og-default.png /mipo-mark.svg /placeholder.svg
	handle @branded {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/www
		@static file
		handle @static {
			header Cache-Control "no-cache"
			file_server
		}
		handle {
			reverse_proxy mipo-api:3000 {
				header_up X-Forwarded-For {remote_host}
			}
		}
	}
}
