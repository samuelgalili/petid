# Database dumps. A production dump is a full copy of every customer record;
# it must never end up in the repository, on any branch, by any accident.
*.sql.gz
*.dump
backups/

# User media. The API writes uploads here when it runs locally, and neither
# directory was ignored — so a photo, or a scanned insurance claim out of
# private-uploads/, would show up as an untracked file waiting to be committed
# by accident. On the server these are Docker volumes and never come from git.
uploads/
private-uploads/
